# Required for real Gemini calls. Get a free key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Default model; players can also pick a model per story in the setup form.
MODEL_NAME=gemini-3.5-flash

# Text model source is picked PER STORY in the setup form: gemini (cloud,
# default), groq or openrouter (named cloud providers with their own keys
# below), or openai/local — any OpenAI-compatible LOCAL server (Ollama,
# LM Studio, llama.cpp), which can run uncensored fine-tunes with no content
# filters at all. LLM_PROVIDER only sets the default choice for the setup
# form. See README "Free cloud providers".
LLM_PROVIDER=gemini
# Groq cloud (free ~1000 req/day, very fast; provider moderation on top).
# Key from https://console.groq.com/keys — empty disables Groq in the picker.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# OpenRouter cloud (free tier 50 req/day; 1000/day after a one-time $10
# top-up). Key from https://openrouter.ai/keys — empty disables OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Mistral cloud (Experiment tier ~1B tokens/month free, no card — SMS only;
# moderate censorship, but free-tier prompts may train their models).
# Key from https://console.mistral.ai — empty disables Mistral in the picker.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# Local server: Ollama's default OpenAI-compatible endpoint; LM Studio:
# http://localhost:1234/v1. Local servers ignore the key; any non-empty value
# works. The model tag as the server knows it (ollama list).
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1:8b
DATABASE_URL=sqlite:///./story.db
# Needs to fit long, dialogue-rich turns (350-700 words each).
MAX_TOKENS=4000

# Scene illustrations via local ComfyUI (http://127.0.0.1:8188).
IMAGE_GENERATION_ENABLED=true
COMFYUI_URL=http://127.0.0.1:8188
IMAGE_TIMEOUT_SECONDS=300
IMAGE_DIR=./data/images
# true = skip ComfyUI and write a placeholder PNG after ~3s (no GPU needed).
MOCK_IMAGES=false
# Sampler steps per image; generation time is roughly linear in this number.
# 25 is what the bundled workflows ship with. 16 is ~1.5x faster and still keeps
# detail; below ~12 Qwen-Image starts losing hands, fabric and small props.
IMAGE_STEPS=25
# One seed for EVERY picture — the same value the bundled workflow files carry.
# With a fixed seed the same prompt reproduces the same image, so "repaint" really
# repaints instead of drawing something else.
IMAGE_SEED=593103825222985

# Optional: feed character portraits back into scene generation so faces and
# outfits stay consistent pictures, not just prompt text. img2img mode wires the
# first in-scene portrait into the first sampler through an auto-injected
# LoadImage/ImageScale/VAEEncode chain — no workflow editing needed.
# off = disabled (default).
IMAGE_REFERENCE_MODE=off
# Optional comma-separated extra LoadImage node ids for hand-built workflows.
IMAGE_REFERENCE_NODES=
# How far the first sampler may move away from the reference. 0.65 keeps the
# likeness but also keeps the portrait's composition and background in scenes
# ("the new place does not show"); 0.75 lets the scene prompt own the place
# while the face still reads as the same character.
IMAGE_REFERENCE_DENOISE=0.75
# Scene images normally render from the scene prompt plus the characters' stored
# appearance tags. Turning this on feeds the first in-scene portrait into the
# SCENE sampler as well: it holds faces tightly, but the 4:5 portrait lands on
# the 16:9 scene canvas, so the picture inherits the portrait's crop and pose
# (chest-level close-up, the other characters cropped away) instead of the
# framing the scene asked for. Off by default; portraits always keep their own
# previous-look reference.
IMAGE_SCENE_REFERENCE=false

# Development mode: returns prepared valid turns without calling the API.
MOCK_LLM=true

# VRAM conductor: on a single GPU shared by Ollama (text) and ComfyUI (images),
# unload the text model from VRAM before every image job (Ollama keep_alive=0)
# and free ComfyUI's model cache after it (POST /free), so both never hold
# VRAM at once. The text model reloads on the next turn (~10-30 s once).
GPU_VRAM_CONDUCTOR=false
